# ── 포용이 웹 프로토타입 환경변수 ─────────────────────────────────────
#
# 기본값(키 미설정)으로도 100% 동작합니다 = 자립형 데모 모드.
# 아래 키를 채우면 챗봇이 규칙기반 mock 엔진 대신 실제 Gemini 로 응답합니다.
#
# 주의: NEXT_PUBLIC_ 접두사 키는 클라이언트 번들에 포함됩니다.
#       프로토타입/로컬 시연 전용입니다. 운영에서는 키를 절대 클라이언트에
#       노출하지 말고 backend(FastAPI) 를 경유해야 합니다(README 참고).

# Google AI Studio 발급 키 (https://aistudio.google.com/apikey)
NEXT_PUBLIC_GEMINI_API_KEY=

# 모델 라우팅 (미설정 시 기본값 사용)
NEXT_PUBLIC_GEMINI_CHAT_MODEL=gemini-2.5-flash
NEXT_PUBLIC_GEMINI_CLASSIFY_MODEL=gemini-2.5-flash
