{
  "name": "@finnect/web-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "포용이 자립형 데모 웹앱 — 온보딩→AI 멘토→정책 추천→정부 대시보드 (백엔드 무의존, Gemini 키 있으면 실 API 자동 전환). Capacitor 로 Android 패키징.",
  "scripts": {
    "dev": "next dev -p 3100",
