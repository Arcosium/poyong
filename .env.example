# ──────────────────────────────────────────────────────────────
# FIN:NECT — environment variables
# 복사: cp .env.example backend/.env  (백엔드는 backend/.env 를 읽습니다)
# ──────────────────────────────────────────────────────────────

# --- Backend / DB ---
# 운영 기본값은 PostgreSQL. 로컬에서 docker 없이 돌리려면 sqlite URL 로 교체 가능:
#   DATABASE_URL=sqlite+aiosqlite:///./finnect.sqlite3
DATABASE_URL=postgresql+asyncpg://finnect:finnect@localhost:5432/finnect
REDIS_URL=redis://localhost:6379/0

# --- Local LLM (OpenAI-compatible; no API key) ---
# Set the URL after choosing the local server, e.g. http://127.0.0.1:8000/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=Qwen3.6-35B-A3B-Uncensored-Claude-Genesis-Q8_0.gguf
LOCAL_LLM_MAX_OUTPUT_TOKENS=2048

# --- Security ---
DEVICE_ID_SECRET=change-me-32-bytes-base64   # 디바이스 ID HMAC 키
JWT_SECRET=change-me-too                      # 익명 세션 JWT 서명 키
JWT_EXPIRE_MINUTES=43200                      # 30일

# --- 정부 대시보드 (Basic Auth) ---
GOV_DASHBOARD_BASIC_AUTH_USER=admin
GOV_DASHBOARD_BASIC_AUTH_PASS=change-me

# --- 공공데이터포털 (정책 상품 동기화 v2) ---
PUBLIC_DATA_API_KEY=

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Gov dashboard (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
